#usda 1.0
(
    metersPerUnit = 1.0
    upAxis = "Y"
    subLayers = [
        @C:\Users\paolo\Desktop\openusd\Kitchen_set\Kitchen_set_instanced.usd@,
    ]
)

over "Kitchen_set"
{
    float3 xformOp:rotateXYZ = (-90, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def Camera "renderCam"
{
    float2 clippingRange = (0.1, 1000)
    float focalLength = 60
    float horizontalAperture = 37.0
    token projection = "perspective"
    float verticalAperture = 22.1
    matrix4d xformOp:transform = ( (0.35836794954530016, -6.93889390390723e-18, -0.933580426497202, 0), (-0.1137748335931116, 0.9925461516413222, -0.04367406670853477, 0), (0.9266216595674619, 0.12186934340514755, 0.35569672919277906, -0), (726.471672960961, 167.33027086028792, 236.60471070649515, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

def "Render"
{
    def RenderSettings "GeminiRenderSettings"
    {
        custom bool gemini:enableSubsurface = True (
            uiHints = {
                string displayName = "Enable Subsurface Scattering"
                string displayGroup = "Performance"
            }
        )
        custom bool gemini:enableRestirGI = True (
            uiHints = {
                string displayName = "Enable ReSTIR GI"
                string displayGroup = "Performance"
            }
        )
        custom bool gemini:physicalSkyEnable = True (
            uiHints = {
                string displayName = "Enable Physical Sky"
                string displayGroup = "Physical Sky"
            }
        )
        custom float gemini:physicalSkyAltitude = 30.0 (
            uiHints = {
                string displayName = "Physical Sky Altitude"
                string displayGroup = "Physical Sky"
            }
        )
        custom float gemini:physicalSkyAzimuth = -110.0 (
            uiHints = {
                string displayName = "Physical Sky Azimuth"
                string displayGroup = "Physical Sky"
            }
        )
        custom bool gemini:enablePhysicalCamera = True (
            uiHints = {
                string displayName = "Override Physical Camera Parameters"
                string displayGroup = "Camera"
            }
        )
        custom float gemini:iso = 50.0 (
            uiHints = {
                string displayName = "ISO"
                string displayGroup = "Camera"
            }
        )
        custom float gemini:shutterSpeed = 0.0001 (
            uiHints = {
                string displayName = "Shutter Speed"
                string displayGroup = "Camera"
            }
        )
        custom int gemini:targetSampleCount = 1024 (
            uiHints = {
                string displayName = "Target Sample Count"
                string displayGroup = "Sampling"
            }
        )
    }
}
